{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/catalog", "destination": "/category.html" },
    { "source": "/category", "destination": "/category.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/news", "destination": "/news.html" },
    { "source": "/blog", "destination": "/news.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/home-2", "destination": "/home-2.html" },
    { "source": "/home-3", "destination": "/home-3.html" }
  ]
}
